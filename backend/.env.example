# ── Reign Content Publisher — backend environment ──
# Copy to .env and fill in. The Settings page can also edit these at runtime.

# Anthropic (required for generation)
ANTHROPIC_API_KEY=
# Model used for generation. Leave as-is unless you have a reason to change it.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase (optional — if unset, an in-memory store is used for local dev)
SUPABASE_URL=
SUPABASE_KEY=

# Medium (optional — integration token + user id)
MEDIUM_TOKEN=
MEDIUM_USER_ID=

# LinkedIn (optional — access token + author urn, e.g. urn:li:person:XXXX)
LINKEDIN_TOKEN=
LINKEDIN_AUTHOR_URN=

# Server
PORT=8000
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173
