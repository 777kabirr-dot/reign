# ── Reign OS — environment variables ──
# Copy to .env and fill in. Never commit the real .env.

# Anthropic (Claude) — all AI operations
ANTHROPIC_API_KEY=

# Serper API — SERP monitoring
SERPER_API_KEY=

# Supabase (PostgreSQL)
SUPABASE_URL=
SUPABASE_KEY=

# Google Indexing API — OAuth access token / service bearer
GOOGLE_INDEXING_KEY=

# WordPress REST API — article distribution
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Morning digest webhook (WhatsApp / Slack / Discord incoming webhook)
NOTIFICATION_WEBHOOK=

# Server
PORT=8000

# Comma-separated allowed CORS origins (e.g. https://reign.vercel.app)
CORS_ORIGINS=*

# Optional: override reports output directory (absolute path)
# REPORTS_DIR=/data/reports
